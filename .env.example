# =============================================================================
# ExpenseTracker Environment Configuration Template
# Duplicate this file as '.env' and populate with your local values.
# NEVER commit your actual '.env' file or real credentials to Git!
# =============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_tracker
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password

# JWT Security
# Generate a strong 256-bit (64 hex characters) secret key
JWT_SECRET=your_64_character_hex_jwt_secret_key_here
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Google OAuth2 / OpenID Connect (Optional for local email/password login)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application & OAuth Redirects
APP_FRONTEND_URL=http://localhost:3000
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/login?error=oauth_failed
OAUTH2_EXCHANGE_EXPIRATION_SECONDS=300

# Email Verification (SMTP Configuration)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM=noreply@expensetracker.com
MAIL_AUTH=true
MAIL_STARTTLS_ENABLE=true
EMAIL_VERIFICATION_EXPIRATION_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Frontend Dev Server Proxy Target
BACKEND_URL=http://localhost:8080
